rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      // Any authenticated user can read profiles (e.g. for leaderboards)
      allow read: if isAuthenticated();

      // Creation: authenticated user can create their own profile, but MUST NOT set role to 'admin'
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';

      // Updates: user can update own profile, but CANNOT modify the 'role' field unless they have admin claim
      allow update: if isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // Educational hierarchy: Classes, Subjects, Chapters, Quizzes, Questions
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      // Anyone can read published quizzes; admins can read all
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quiz Attempts
    match /attempts/{attemptId} {
      // Users can read and create their own attempts; admins can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && (
        favoriteId.matches('^' + request.auth.uid + '_.*') ||
        request.resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Admin Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // AI Correction Reports
    match /aiCorrectionReports/{reportId} {
      allow read, write: if isAdmin();
    }
  }
}
